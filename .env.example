# Copy to .env; never commit the real key or put it in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# NVIDIA / Brev environment:
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Local API in development; serves frontend + API after npm run build / npm start.
HOST=127.0.0.1
PORT=3001
# Experimental prototypes are excluded from the accepted main scenario.
VITE_ENABLE_EXPERIMENTS=false

